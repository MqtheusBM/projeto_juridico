# DataJud/CNJ — obtenha a chave vigente na documentação oficial e configure localmente.
DATAJUD_API_KEY=
# Cache agregado persistente: validade padrão de 6 horas (60 a 604800 segundos).
DATAJUD_CACHE_TTL_SECONDS=21600
# Opcional; por padrão usa backend/.datajud_cache.sqlite3.
# DATAJUD_CACHE_DB=

# API local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
